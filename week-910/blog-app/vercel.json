{
  "version": 2,
  "builds": [
    {
      "src": "blog-app-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "blog-app-frontend/dist"
      }
    },
    {
      "src": "blog-app-backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/blog-app-backend/server.js"
    },
    {
      "src": "/user-api/(.*)",
      "dest": "/blog-app-backend/server.js"
    },
    {
      "src": "/author-api/(.*)",
      "dest": "/blog-app-backend/server.js"
    },
    {
      "src": "/common-api/(.*)",
      "dest": "/blog-app-backend/server.js"
    },
    {
      "src": "/admin-api/(.*)",
      "dest": "/blog-app-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/blog-app-frontend/index.html"
    }
  ]
}